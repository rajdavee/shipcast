    { "key": "captions", "label": "Captions", "type": "select", "choices": ["clean", "karaoke", "boxed", "bold", "none"], "default": "clean" },
    { "key": "angle", "label": "Angle", "type": "text", "default": "", "placeholder": "e.g. v2 launch — the new editor" }
