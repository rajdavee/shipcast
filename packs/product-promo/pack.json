      "default": "1920x1080"
    },
    {
      "key": "voiceover",
      "label": "Voiceover",
      "type": "select",
      "choices": [
        "yes",
        "no"
      ],
      "default": "yes"
    },
    {
      "key": "voice",
      "label": "Voice",
      "type": "select",
      "choices": [
        "af_heart",
        "af_nova",
        "af_sky",
        "am_adam",
        "am_michael",
        "bf_emma",
        "bm_george"
      ],
      "default": "af_heart"
    },
    {
      "key": "angle",
      "label": "Angle",
      "type": "text",
      "default": "",
      "placeholder": "e.g. feature reveal of the new editor"
    }
  ],
  "outputs": [
    "*.mp4",
    "*.jpg",
    "*.srt",
    "*.vtt",
    "*.md"
  ],
  "skills": [
