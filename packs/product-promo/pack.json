{
  "id": "product-promo",
  "name": "Product Promo \u00b7 freeform",
  "tagline": "Narrated 30\u201360s promo: hook, demo of the real flow, proof, CTA \u2014 with local AI voiceover.",
  "category": "video",
  "order": 21,
  "estimate": "20\u201340 min",
  "accent": "#7c5cff",
