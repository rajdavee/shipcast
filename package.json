{
  "name": "shipcast",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first studio that turns a URL or a GitHub repo into a full launch campaign — videos, motion graphics, carousels, thumbnails and copy — using your own Claude Code login.",
  "type": "module",
  "license": "MIT",
  "author": "rajdavee",
  "repository": { "type": "git", "url": "git+https://github.com/rajdavee/shipcast.git" },
  "engines": { "node": ">=22.18" },
  "workspaces": ["apps/web", "services/engine", "services/api", "services/worker"],
  "bin": { "shipcast": "bin/shipcast.ts" },
  "scripts": {
    "dev": "node bin/shipcast.ts dev",
    "build": "npm run build -w apps/web",
    "start": "node bin/shipcast.ts start",
    "worker": "node services/worker/src/main.ts",
    "doctor": "node bin/shipcast.ts doctor",
    "test": "node --test \"services/**/*.test.ts\" \"tests/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w apps/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.3"
  }
}
